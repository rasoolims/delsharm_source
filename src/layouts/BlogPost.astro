            document.documentElement.classList.add('dark-mode');
        }
    </script>
    <link rel="alternate" type="application/rss+xml" title="وب‌نوشت‌های دلشرم" href="/delsharm/rss.xml" />
    <meta name="google-site-verification" content="mg8IXQt3fbDtkRvs5Hq58jPSIh9-F7Otxg64p517cvY" />
</head>
<body>
    <div class="single-post-container">
        
        <div class="page-header">
            
            <!-- Empty space to keep the layout balanced with the theme toggle -->
            <div class="header-right" style="min-width: 40px;">
                <!-- Goodreads -->
                <a href="https://www.goodreads.com/user/show/16679517-mohammad-sadegh-rasooli" target="_blank" title="گودریدز" class="brand-icon" style="color: #d8a436;">
                    <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor">
